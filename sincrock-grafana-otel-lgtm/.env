# Altere esta senha para uma senha segura antes de iniciar o aplicativo. A senha padrão é "admin".
GF_SECURITY_ADMIN_PASSWORD="admin"

# Ativa os logs internos dos componentes para ajudar no debug
ENABLE_LOGS_ALL=true 

# Define o caminho do dashboard padrão do Grafana
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH="/otel-lgtm/grafana/conf/provisioning/dashboards/custom/custom-dashboard.json"

# Abilita a instrumentação eBPF do OpenTelemetry
ENABLE_OBI=true